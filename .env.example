# Copia este archivo como .env (solo para pruebas locales con `vercel dev`).
# En producción, estas variables se configuran en el panel de Vercel, no en este archivo.

# El correo de Gmail que envía y recibe los mensajes del formulario.
GMAIL_USER=aceraluminios297@gmail.com

# Una "contraseña de aplicación" de Gmail (no la contraseña normal de la cuenta).
# Se genera en: https://myaccount.google.com/apppasswords (requiere verificación en dos pasos activada).
GMAIL_APP_PASSWORD=
